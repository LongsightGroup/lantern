FROM python:3.15-slim-trixie

COPY --from=docker.io/cloudflare/sandbox:1.0.3 /usr/local/bin/sandbox-shim /usr/local/bin/sandbox-shim

# The interpreter has no third-party packages; grading also uses -I -S.
RUN rm -rf /usr/local/lib/python*/site-packages /usr/lib/python*/site-packages \
    && mkdir -p /workspace
WORKDIR /workspace
CMD ["sleep", "infinity"]
