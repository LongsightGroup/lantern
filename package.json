{
  "name": "lantern",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate": "cf d1 migrations apply 0f0a956c-c1f8-43dd-bcdb-80577be94856 --dir src/db/d1_migrations --local --persist-to .cloudflare/state",
    "db:migrate:remote": "cf d1 migrations apply 0f0a956c-c1f8-43dd-bcdb-80577be94856 --dir src/db/d1_migrations",
    "app:validate": "node tools/app_validate.ts",
    "app:preview": "node tools/app_preview.ts",
    "app:dev": "node tools/app_dev.ts",
    "app:test-preview": "node tools/app_test_preview.ts",
    "app:new": "node tools/app_new.ts",
    "app:build-worker": "node tools/build_reviewed_worker_app.ts",
    "reference:sync": "node tools/reference_sync.ts",
    "local:init": "node tools/local_init.ts",
    "local:migrate": "npm run db:migrate",
    "local:bootstrap": "npm run local:migrate",
    "local:start": "cf dev",
    "local:dev": "cf dev",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "npm run types && vp lint --deny-warnings",
    "check": "npm run types && vp check --deny-warnings",
    "test": "npm run types && vp test run",
    "check:worker": "npm run build && node tools/check_worker_bundle.ts && node tools/check_worker_config.ts && npm run check:deploy",
    "validate": "npm run schemas:check && npm run check && npm run check:worker && npm test",
    "postinstall": "node tools/patch_miniflare_browser.mjs && node tools/patch_cf_helpers.mjs",
    "browser:install": "node tools/install_preview_browser.ts",
    "check:browser": "vp test run --project workers src/app_writer/cloudflare_browser_preview_integration_test.ts",
    "build": "cf build",
    "deploy": "npm run build && cf deploy --prebuilt --mode production --worker lantern-app-writer-platform-services && cf deploy --prebuilt --mode production",
    "types": "cf workers types --no-include-runtime",
    "schemas:generate": "node tools/generate_schema_validators.ts",
    "schemas:check": "node tools/generate_schema_validators.ts --check",
    "check:deploy": "cf deploy --prebuilt --mode production --worker lantern-app-writer-platform-services --dry-run && cf deploy --prebuilt --mode production --dry-run"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.5.0-rc.0",
    "@cloudflare/sandbox": "1.0.3",
    "@hono/node-server": "2.1.6",
    "@longsightgroup/lti-tool": "0.1.8",
    "better-auth": "1.7.15",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "jose": "6.2.15",
    "oauth4webapi": "3.8.8",
    "semver": "7.8.6"
  },
  "devDependencies": {
    "@cloudflare/build-output-utils": "0.9.9",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.11",
    "@cloudflare/vitest-plugin": "1.5.1",
    "@cloudflare/workers-types": "5.20261103.1",
    "@cloudflare/workers-utils": "0.51.1",
    "@puppeteer/browsers": "3.2.6",
    "@std/assert": "npm:@jsr/std__assert@1.0.19",
    "@types/node": "26.6.6",
    "@types/semver": "7.8.0",
    "ajv": "8.20.0",
    "cf": "1.0.0-beta.27",
    "esbuild": "0.28.2",
    "miniflare": "5.20261103.0-beta",
    "puppeteer-core": "25.16.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "@cloudflare/config": "0.30.1",
    "miniflare": "$miniflare",
    "vite": "$vite",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=26.13.0 <27",
    "npm": ">=12.2.1 <13"
  },
  "packageManager": "npm@12.2.1",
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "fsevents": false
  }
}
